# 远程控制运行配置
# 可以直接手动编辑；这里的值会覆盖代码内置默认值。

# 安全
RC_PAIR_ENABLED=1
RC_PAIR_CODE=041013
RC_PAIR_MAX_ATTEMPTS=3

# 画面
RC_CAPTURE_BACKEND=auto
RC_QUALITY=95
RC_WEBRTC_FPS=45
RC_WEBRTC_SCALE=1.0

# 声音
RC_AUDIO_ENABLED=1
RC_AUDIO_DEVICE_NAME=CABLE Output
RC_AUDIO_TRANSPORT_DEFAULT_ENABLED=1

# 启动
RC_SERVER_AUTORESTART=1
RC_SERVER_RESTART_DELAY_SEC=2
